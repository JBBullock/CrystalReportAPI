*.pyc

# Secrets / environment
.env

# TLS private key + cert - see generate_cert.py's docstring: these are
# regenerated locally (or per-deployment), not something to commit.
# cert.pem specifically also has to be hand-copied to every SecureZMRP
# client as CA_CERT_PATH, so keeping it out of history isn't just about
# the private key.
report_api_certs/

