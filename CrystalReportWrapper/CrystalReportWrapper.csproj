<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Crystal Reports for .NET only ships assemblies for classic .NET Framework,
         so this has to target net48, not net6.0/net8.0 etc. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CrystalReportWrapper</AssemblyName>
    <RootNamespace>CrystalReportWrapper</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Note: PublishSingleFile / self-contained deployment is a modern .NET
         (netcoreapp/net5+) feature and doesn't apply to net48. Classic
         .NET Framework apps always run against Framework already installed
         on the machine (which it will be here, since the CR runtime install
         requires it too). So this publishes as a normal folder of files
         instead of one bundled exe: CrystalReportWrapper.exe plus its
         .dll dependencies sitting next to it. Python just needs the path to
         the .exe; the rest of the folder needs to travel with it. -->
    <!-- NOTE: this app no longer connects to Postgres via ODBC (the 32-bit
         ODBC driver was unreliable on this machine, and getting the 64-bit
         Crystal COM runtime to register correctly ran into unrelated OS-level
         issues). Instead, Postgres is queried directly in C# using Npgsql
         (a pure managed .NET driver - see FetchReportData()), and the
         resulting DataTable is handed to Crystal via SetDataSource(). That
         removes any ODBC/driver-bitness dependency, but does NOT remove
         the Crystal-side bitness dependency: this report's table is bound
         to a .ttx (field-definitions-only) source, and Crystal has never
         shipped a 64-bit driver for that (crdb_fielddef.dll). Even though
         SetDataSource() succeeds under x64, ExportToDisk() still touches
         the table's original recorded connection during formatting and
         fails with "Failed to load database information" there. x86 is
         what the CR COM runtime has reliably registered as on this
         machine throughout this whole debugging process - this was
         previously flipped to x64 (probably while chasing the unrelated
         ODBC bitness issue above) without updating this comment. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <!--
      These three assemblies are installed into the GAC (Global Assembly
      Cache) by the SAP Crystal Reports for Visual Studio installer rather
      than dropped as loose files, hence the GAC_MSIL path and the versioned/
      public-key-token folder name. <Private>true</Private> tells MSBuild to
      copy the DLL alongside CrystalReportWrapper.exe on publish, which is
      required since GAC assemblies aren't otherwise available at runtime on
      a machine that doesn't have the SDK/runtime installed.
    -->
    <Reference Include="CrystalDecisions.CrystalReports.Engine, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304, processorArchitecture=MSIL">
      <HintPath>.\bin\Debug\net48\CrystalDecisions.CrystalReports.Engine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="CrystalDecisions.Shared,Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304, processorArchitecture=MSIL">
      <HintPath>.\bin\Debug\net48\CrystalDecisions.Shared.dll</HintPath>
      <Private>true</Private>

    </Reference>

    <!-- CrystalDecisions.CrystalReports.Engine's ReportDocument pulls this
         in internally at runtime (it bridges to the native Report
         Application Server components) even though nothing in Program.cs
         references the CrystalDecisions.ReportAppServer namespace
         directly - that's why removing this reference outright wasn't
         enough; the DLL still needs to be present and architecture-
         matched. processorArchitecture is x86 here (not x64) to match
         both the swapped-in 32-bit HintPath DLL and the rest of this
         project's PlatformTarget=x86. This also requires the 32-bit "SAP
         Crystal Reports runtime engine for .NET Framework" (CRRuntime_32bit,
         same 13.0.4000 version) to be installed on this machine alongside
         the existing 64-bit one, so there's an actual native runtime for
         this DLL to bridge to - without it this fails with
         BadImageFormatException on "CommLayer ... or one of its
         dependencies" even when CommLayer.dll itself is correctly x86. -->
    <Reference Include="CrystalDecisions.ReportAppServer.CommLayer, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304, processorArchitecture=x86">
      <HintPath>.\bin\Debug\net48\CrystalDecisions.ReportAppServer.CommLayer.dll</HintPath>
      <Private>true</Private>
    </Reference>

  </ItemGroup>

  <ItemGroup>
    <!-- Minimal, dependency-free JSON writer so we don't need to fight NuGet
         restore against an offline/locked-down build machine. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <!-- Pure managed .NET Postgres driver - no ODBC driver install needed,
         works fine in this x86 process without any bitness concerns. -->
    <PackageReference Include="Npgsql" Version="4.1.13" />
  </ItemGroup>

</Project>
