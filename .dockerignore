# Dev/tooling cruft that shouldn't (and for CrystalReportWrapper's
# Debug build, largely can't - see Dockerfile) end up in the image.
.git/
.venv/
__pycache__/
*.pyc
Scratch/
SQLFetches/

bin64/
jsonInspections/inspect-sales.json

# TLS private key - mounted as a volume by docker-compose.yml instead of
# baked into an image layer (see that file's comment). Never want this
# accidentally COPYed in even if the volume mount is removed later.
report_api_certs/

# Test output from main.py.
out/
*.pdf

# CrystalReportWrapper build cruft: intermediate obj/ files, the Debug
# build (the image uses the Release publish/ output instead - see
# report_service.py's RPTCONVERT_WORKER_EXE), old .bak snapshots, and the
# scratch folder someone was part-way through cleaning up.
CrystalReportWrapper/obj/
CrystalReportWrapper/bin/Debug/
CrystalReportWrapper/_scratch_to_delete/
CrystalReportWrapper/*.bak_*
CrystalReportWrapper/Program.cs.bak_*

# Compose/env files themselves don't need to be inside the image.
docker-compose.yml
.env
.env.example

# Old code set aside by the stateless rewrite, and other dev-only folders.
_to_delete/
config/
CrystalReportAPI/
CrystalReportAPI.zip
